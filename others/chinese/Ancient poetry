let currentGrade = "七年级";
let currentSemester = "上册";

// 构建左侧导航
function buildSidebar() {
  const sidebar = document.getElementById("sidebar");
  // 保留 header，追加导航按钮
  const grades = Object.keys(DATA);
  let navHtml = '';
  grades.forEach(grade => {
    navHtml += `<div class="grade-group">`;
    navHtml += `<div class="grade-label">${grade}</div>`;
    ["上册", "下册"].forEach(sem => {
      const count = DATA[grade][sem].length;
      const active = (grade === currentGrade && sem === currentSemester) ? "active" : "";
      navHtml += `<button class="sem-btn ${active}" data-grade="${grade}" data-sem="${sem}" onclick="selectSemester('${grade}','${sem}')">${sem}<span class="count">${count}篇</span></button>`;
    });
    navHtml += `</div>`;
  });
  sidebar.innerHTML = `<div class="sidebar-header">
    <h1>必背古诗文</h1>
    <p>统编版 初中 7-9年级</p>
  </div>` + navHtml;
}

// 点击左侧导航
function selectSemester(grade, sem) {
  stopAllTts();
  currentGrade = grade;
  currentSemester = sem;
  // 更新按钮高亮
  document.querySelectorAll('.sem-btn').forEach(btn => btn.classList.remove('active'));
  const target = document.querySelector(`.sem-btn[data-grade="${grade}"][data-sem="${sem}"]`);
  if (target) target.classList.add('active');
  // 渲染右侧
  renderContent(grade, sem);
  // 滚动到顶部
  document.getElementById('contentArea').scrollTop = 0;
}

// 渲染右侧内容
function renderContent(grade, sem) {
  const items = DATA[grade][sem];
  const area = document.getElementById("contentArea");
  let html = `<div class="content-header">
    <h2>${grade}·${sem}</h2>
    <div class="desc">共 ${items.length} 篇必背 · 点击篇目展开全文与读音</div>
  </div>`;

  items.forEach((item, idx) => {
    html += renderItem(item, idx);
  });

  area.innerHTML = html;
}

function renderItem(item, idx) {
  const tagClass = item.tag || "gushi";
  const tagLabel = item.tagLabel || "古诗";
  let textHtml = item.text;

  // 给生僻字加 ruby 注音
  if (item.pron && item.pron.length > 0) {
    const sortedPron = [...item.pron].sort((a, b) => b.c.length - a.c.length);
    for (const p of sortedPron) {
      const escaped = p.c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(escaped, 'g');
      textHtml = textHtml.replace(regex, `<ruby>${p.c}<rt>${p.p}</rt></ruby>`);
    }
  }

  // 现代文按段落拆分，每段 <p> 首行缩进两格；其他用 <br> 换行
  const isModern = item.tag === 'xiandai';
  if (isModern) {
    const paragraphs = textHtml.split('\n').filter(p => p.trim().length > 0);
    textHtml = paragraphs.map(p => '<p>' + p + '</p>').join('');
  } else {
    textHtml = textHtml.replace(/\n/g, '<br>');
  }

  let pronHtml = '';
  if (item.pron && item.pron.length > 0) {
    pronHtml = `<div class="pron-section">
      <div class="pron-title">📖 读音说明</div>
      <div class="pron-list">`;
    item.pron.forEach(p => {
      pronHtml += `<span class="pron-item"><span class="char">${p.c}</span> <span class="pinyin">${p.p}</span></span>`;
    });
    pronHtml += `</div></div>`;
  }

  let notesHtml = '';
  if (item.notes && item.notes.length > 0) {
    notesHtml = `<div class="notes-section">
      <div class="notes-title">📝 重点注释</div>
      <div class="notes-list">`;
    item.notes.forEach(n => {
      notesHtml += `<div class="notes-item"><span class="word">${n.w}</span><span class="meaning">${n.m}</span></div>`;
    });
    notesHtml += `</div></div>`;
  }

  return `<div class="poem-item" id="item-${idx}">
    <div class="poem-header" onclick="toggleItem(${idx})">
      <div class="poem-title-wrap">
        <span class="poem-title">${item.title}</span>
        <span class="poem-author">· ${item.author}（${item.dynasty}）</span>
        <span class="poem-tag ${tagClass}">${tagLabel}</span>
      </div>
      <span class="arrow">▼</span>
    </div>
    <div class="poem-content-wrap">
      <div class="poem-content">
        <div class="tts-bar">
          <button class="tts-btn" id="tts-btn-${idx}" onclick="speakPoem(${idx}, event)">
            <span class="icon">🔊</span><span class="tts-label">朗诵</span>
          </button>
          <div class="tts-speed">
            <label>语速</label>
            <select id="tts-speed-${idx}" onchange="changeSpeed(${idx}, this.value)">
              <option value="0.7">慢</option>
              <option value="0.85">较慢</option>
              <option value="0.95" selected>正常</option>
              <option value="1.1">较快</option>
            </select>
          </div>
          <div class="tts-status" id="tts-status-${idx}"><span class="dot"></span><span class="tts-status-text">就绪</span></div>
        </div>
        <div class="poem-text ${item.tag === 'xiandai' ? 'modern' : ''}">${textHtml}</div>
        ${pronHtml}
        ${notesHtml}
        <div class="poem-meta">${item.note || ''}</div>
      </div>
    </div>
  </div>`;
}

// 展开/折叠篇目
function toggleItem(idx) {
  const el = document.getElementById('item-' + idx);
  if (el) el.classList.toggle('open');
}

// ============ 语音朗诵 ============
let currentUtterance = null;
let currentTtsIdx = null;

function getCleanText(idx) {
  // 获取当前学期的篇目数据
  const items = DATA[currentGrade][currentSemester];
  const item = items[idx];
  if (!item) return '';
  // 去掉换行符，用句号/逗号自然停顿
  let raw = item.text;
  // 把 \n 替换为逗号停顿（让语音有节奏感）
  raw = raw.replace(/\n/g, '，');
  return raw;
}

function speakPoem(idx, event) {
  if (event) event.stopPropagation();

  // 如果正在朗读这一篇，则停止
  if (currentTtsIdx === idx && window.speechSynthesis.speaking) {
    stopSpeak();
    return;
  }

  // 停止之前的朗读
  stopSpeak();

  const text = getCleanText(idx);
  if (!text) return;

  const items = DATA[currentGrade][currentSemester];
  const item = items[idx];

  // 前缀：标题 + 作者
  let fullText = '';
  if (item.title) fullText += item.title + '。';
  if (item.author && item.dynasty) fullText += item.dynasty + '，' + item.author + '。';
  fullText += text;
  if (item.note) fullText += '。' + item.note;

  const utter = new SpeechSynthesisUtterance(fullText);
  utter.lang = 'zh-CN';

  // 语速
  const speedSelect = document.getElementById('tts-speed-' + idx);
  const rate = speedSelect ? parseFloat(speedSelect.value) : 0.95;
  utter.rate = rate;
  utter.pitch = 1;
  utter.volume = 1;

  // 尝试选中文语音
  const voices = window.speechSynthesis.getVoices();
  const zhVoice = voices.find(v => v.lang.startsWith('zh')) || voices.find(v => v.lang.includes('CN'));
  if (zhVoice) utter.voice = zhVoice;

  // 按钮状态
  const btn = document.getElementById('tts-btn-' + idx);
  const status = document.getElementById('tts-status-' + idx);
  if (btn) {
    btn.classList.add('playing');
    btn.querySelector('.icon').textContent = '⏹';
    btn.querySelector('.tts-label').textContent = '停止';
  }
  if (status) {
    status.classList.add('active');
    status.querySelector('.tts-status-text').textContent = '朗诵中…';
  }

  currentUtterance = utter;
  currentTtsIdx = idx;

  utter.onend = function() {
    resetTtsButton(idx);
    currentUtterance = null;
    currentTtsIdx = null;
  };

  utter.onerror = function() {
    resetTtsButton(idx);
    currentUtterance = null;
    currentTtsIdx = null;
  };

  window.speechSynthesis.speak(utter);
}

function stopSpeak() {
  if (window.speechSynthesis.speaking) {
    window.speechSynthesis.cancel();
  }
  if (currentTtsIdx !== null) {
    resetTtsButton(currentTtsIdx);
  }
  currentUtterance = null;
  currentTtsIdx = null;
}

function resetTtsButton(idx) {
  const btn = document.getElementById('tts-btn-' + idx);
  const status = document.getElementById('tts-status-' + idx);
  if (btn) {
    btn.classList.remove('playing');
    btn.querySelector('.icon').textContent = '🔊';
    btn.querySelector('.tts-label').textContent = '朗诵';
  }
  if (status) {
    status.classList.remove('active');
    status.querySelector('.tts-status-text').textContent = '就绪';
  }
}

function changeSpeed(idx, val) {
  // 如果正在朗读这一篇，重新开始用新语速
  if (currentTtsIdx === idx && window.speechSynthesis.speaking) {
    stopSpeak();
    setTimeout(() => speakPoem(idx), 100);
  }
}

// 页面切换时停止朗诵
function stopAllTts() {
  stopSpeak();
}

// 预加载语音列表（部分浏览器需要）
if (typeof speechSynthesis !== 'undefined') {
  speechSynthesis.onvoiceschanged = function() {
    // 语音列表就绪
  };
}

// 初始化
buildSidebar();
renderContent(currentGrade, currentSemester);
</script>
</body>
</html>
